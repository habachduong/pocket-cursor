# User config (contains secrets)
.env

# PocketCursor runtime state (auto-generated)
.owner_id
.chat_id
.bridge.lock
.muted
.active_chat
.context_pcts

# Journals (personal to each conversation, except example)
.pocket-cursor/journals/*
!.pocket-cursor/journals/2026-02-20-communication-review.md

# Phone outbox (transient files sent to Telegram)
_phone_outbox/
!_phone_outbox/_EXAMPLE.md

# Voice message input (transient, user-specific)
scripts/voice_message.json

# Runtime logs (audio quality metrics etc.)
logs/

# Local test/scratch scripts
tests/
.commitmsg

# Internal docs (plans, reviews, notes)
docs/

# Node.js (md_to_image.mjs dependencies)
node_modules/
package-lock.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Local Cursor rule copy (absolute machine path). Template: pocket-cursor.mdc
.cursor/rules/pocket-cursor.mdc

# Local tooling (portable gh, etc.)
.tools/
Thumbs.db
Desktop.ini
